# Normalize line endings in the repo; check out native on Windows.
* text=auto

# Keep LF for files executed by a shell or Node.
*.mjs text eol=lf
*.sh  text eol=lf
*.svg text eol=lf

# Binary assets — never apply line-ending conversion. The vendored
# canvas-design fonts are corrupted by it.
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.skill binary
